#!/usr/bin/env bash
#
# 1. Layer vLLM[bench] (+ its aarch64 CUDA torch wheel, pandas, datasets) and
#    matplotlib into the squashfs, so the benchmark's vLLM sweep + plotting work.
# 2. Install a SHA256-verified k6 (Grafana load-testing) arm64 binary.
# 3. Pre-cache the served models' tokenizers into the image so compute nodes (no
#    outbound network on Daint) can tokenize offline (HF_HUB_OFFLINE=1).

set -euo pipefail

VLLM_VERSION="0.25.1"
K6_VERSION="v2.0.0"

STORE_VIEW="{{ env.mount }}/env/default"
PY="$(spack -C {{ env.config }} location -i python)/bin/python3"

# vLLM
export PYTHONUSERBASE="${STORE_VIEW}"          # pip --user installs into the store
# --ignore-installed: install fresh pip/setuptools/wheel into --user (the store view) WITHOUT
# uninstalling the Spack-provided ones; upgrading pip in place corrupts the read-only store copy.
"${PY}" -m pip install --user --no-cache-dir --ignore-installed pip setuptools wheel
# vllm[bench] pulls pandas + datasets (the benchmark's custom-dataset sweep needs
# pandas.read_json); matplotlib is needed by the result-plotting step
"${PY}" -m pip install --user --no-cache-dir "vllm[bench]==${VLLM_VERSION}" pandas matplotlib

# Bake the cached-token parsing into vllm bench (stopgap until the upstream PR lands): stock
# vllm bench drops usage.prompt_tokens_details.cached_tokens; teach it to sum + report them as
# total_cached_tokens / prefix_cache_hit_rate. Fails the build if an anchor no longer matches
# this vLLM, so we never ship an image where the sweep silently reports 0 cached tokens.
"${PY}" - <<'PATCH_EOF'
import importlib.util, pathlib, sys
bench = pathlib.Path(importlib.util.find_spec("vllm").origin).parent / "benchmarks"
EDITS = [
    (
        "lib/endpoint_request_func.py",
        '    prompt_len: int = 0\n    error: str = ""',
        '    prompt_len: int = 0\n'
        '    cached_tokens: int = 0  # cached prompt tokens (prefix cache), from prompt_tokens_details\n'
        '    error: str = ""',
    ),
    (
        "lib/endpoint_request_func.py",
        '                            elif usage := data.get("usage"):\n'
        '                                output.output_tokens = usage.get("completion_tokens")\n'
        '                                if (pt := usage.get("prompt_tokens")) is not None:\n'
        '                                    output.prompt_len = pt',
        '                            elif usage := data.get("usage"):\n'
        '                                output.output_tokens = usage.get("completion_tokens")\n'
        '                                if (pt := usage.get("prompt_tokens")) is not None:\n'
        '                                    output.prompt_len = pt\n'
        '                                details = usage.get("prompt_tokens_details") or {}\n'
        '                                output.cached_tokens = details.get("cached_tokens") or 0',
    ),
    (
        "serve.py",
        '    rtfx: float = 0.0  # Inverse Real-Time Factor for ASR benchmarks',
        '    rtfx: float = 0.0  # Inverse Real-Time Factor for ASR benchmarks\n'
        '    total_cached: int = 0  # cached prompt tokens (prefix cache) across all requests',
    ),
    (
        "serve.py",
        '    total_input = 0\n    completed = 0\n    good_completed = 0',
        '    total_input = 0\n    total_cached = 0\n    completed = 0\n    good_completed = 0',
    ),
    (
        "serve.py",
        '            total_input += outputs[i].prompt_len\n            tpot = 0',
        '            total_input += outputs[i].prompt_len\n'
        '            total_cached += outputs[i].cached_tokens or 0\n'
        '            tpot = 0',
    ),
    (
        "serve.py",
        '        total_input=total_input,\n        total_output=sum(actual_output_lens),',
        '        total_input=total_input,\n'
        '        total_cached=total_cached,\n'
        '        total_output=sum(actual_output_lens),',
    ),
    (
        "serve.py",
        '    print("{:<40} {:<10}".format("Total input tokens:", metrics.total_input))\n'
        '    if isinstance(metrics, BenchmarkMetrics) and tokenizer:',
        '    print("{:<40} {:<10}".format("Total input tokens:", metrics.total_input))\n'
        '    if isinstance(metrics, BenchmarkMetrics):\n'
        '        print("{:<40} {:<10}".format("Cached prompt tokens:", metrics.total_cached))\n'
        '        if metrics.total_input > 0:\n'
        '            print("{:<40} {:<10.1%}".format(\n'
        '                "Prefix cache hit rate:", metrics.total_cached / metrics.total_input))\n'
        '    if isinstance(metrics, BenchmarkMetrics) and tokenizer:',
    ),
    (
        "serve.py",
        '            "total_input_tokens": metrics.total_input,\n'
        '            "total_output_tokens": metrics.total_output,',
        '            "total_input_tokens": metrics.total_input,\n'
        '            "total_cached_tokens": metrics.total_cached,\n'
        '            "prefix_cache_hit_rate": (\n'
        '                metrics.total_cached / metrics.total_input if metrics.total_input else 0.0\n'
        '            ),\n'
        '            "total_output_tokens": metrics.total_output,',
    ),
]
missing = []
for rel, old, new in EDITS:
    p = bench / rel
    src = p.read_text()
    if new in src:
        continue
    if old not in src:
        missing.append(rel)
        continue
    p.write_text(src.replace(old, new))
if missing:
    sys.exit("post-install: cached-token patch anchors not found in "
             + ", ".join(sorted(set(missing)))
             + " -- this vLLM refactored the file; update the patch or bump VLLM_VERSION")
if "total_cached_tokens" not in (bench / "serve.py").read_text():
    sys.exit("post-install: cached-token patch verification failed")
print("post-install: cached-token patch applied under", bench)
PATCH_EOF

# k6 (Grafana) - download + SHA256 verify before installing
tmp="$(mktemp -d)"
trap 'rm -rf "${tmp}"' EXIT
tarball="k6-${K6_VERSION}-linux-arm64.tar.gz"
base="https://github.com/grafana/k6/releases/download/${K6_VERSION}"

curl -fsSL -o "${tmp}/${tarball}"              "${base}/${tarball}"
curl -fsSL -o "${tmp}/checksums.txt"           "${base}/k6-${K6_VERSION}-checksums.txt"

# SHA256 verification
( cd "${tmp}" && grep "  ${tarball}\$" checksums.txt | sha256sum -c - )

tar -xzf "${tmp}/${tarball}" -C "${tmp}"
install -Dm755 "${tmp}/k6-${K6_VERSION}-linux-arm64/k6" "${STORE_VIEW}/bin/k6"

# 3. Pre-cache tokenizers into HF_HOME inside the squashfs.
export HF_HOME="{{ env.mount }}/hf"
mkdir -p "${HF_HOME}"

# swiss-ai/Apertus-v1.5-8B and -70B are GATED on Hugging Face (terms need to be accepted)
# we use the HF_TOKEN of that account so that downloading apertus 1.5 tokenizers succeed.
# This token will be revoked after build of the uenv and is unset at the end of this script.
export HF_TOKEN="REPLACE_ME_THEN_REVOKE"

if [ -z "${HF_TOKEN:-}" ] || [ "${HF_TOKEN}" = "REPLACE_ME_THEN_REVOKE" ]; then
  echo "post-install: WARNING HF_TOKEN is unset -- the gated repos (swiss-ai/Apertus-v1.5-8B" \
       "and -70B) will fail to cache. Set HF_TOKEN from an account that accepted their terms." >&2
fi
# The -thinking variants have no HF repo of their own; they reuse the base v1.5 tokenizers.
for model in \
  swiss-ai/Apertus-8B-Instruct-2509 \
  swiss-ai/Apertus-v1.5-8B \
  swiss-ai/Apertus-v1.5-70B \
  zai-org/GLM-5.2 \
  moonshotai/Kimi-K2.7-Code \
  google/gemma-4-31B-it \
  nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-BF16 ; do
  echo "post-install: caching tokenizer ${model}"
  # Fetch the files straight from the hub instead of via AutoConfig/AutoTokenizer: those
  # parse the checkpoint and abort on an architecture this transformers doesn't know yet
  # (Apertus v1.5 is model_type 'apertus1p5'), even though we only need the files on disk.
  # config.json is included because vLLM loads it at runtime with trust_remote_code=False
  # (otherwise: LocalEntryNotFoundError); *.py covers the custom tokenizers (GLM, Kimi).
  "${PY}" -c "
from huggingface_hub import snapshot_download
snapshot_download('${model}', allow_patterns=[
    'config.json', 'generation_config.json', 'tokenizer*', 'special_tokens_map.json',
    'vocab*', 'merges.txt', '*.model', 'chat_template*', '*.py',
])"
done

# HF_HOME lives inside the squashfs and the image is published to the public service::
# namespace, so make sure no credential ships with it (huggingface-cli login would have
# written one here). Pass HF_TOKEN via the environment instead -- that is never persisted.
rm -f "${HF_HOME}/token" "${HF_HOME}/stored_tokens"
unset HF_TOKEN

echo "post-install complete: vllm==${VLLM_VERSION}, k6 ${K6_VERSION}, tokenizers cached in ${HF_HOME}"
